        <!-- 1. APACHE AIRFLOW 3 -->
        <mxCell id="airflow_zone" value="APACHE AIRFLOW 3 (Astro CLI &amp; Docker)  •  Event-Driven Orchestration&#10;Schedule: [sqs_raw_arrival_asset] (Event-Triggered)  |  catchup=False  |  max_active_runs=1  |  Weekly Full-Refresh (Paused)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontColor=#0D47A1;verticalAlign=top;spacingTop=12;align=center;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="95" width="1580" height="230" as="geometry" />
        </mxCell>

        <mxCell id="af_watcher" value="Triggerer: AssetWatcher&#10;SqsSensorTrigger&#10;SQS Long Polling (20s)&#10;Empty -&gt; 0 DAG Runs ($0)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="175" width="335" height="125" as="geometry" />
        </mxCell>
        <mxCell id="af_load" value="1. @task load_raw_from_sqs&#10;TEMP TABLE Stage + CSV Guards&#10;Empty-Stage Guard (&gt;0 rows)&#10;DELETE + INSERT + Audit SWAPPED" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#FFFFFF;fontColor=#0D47A1;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1265" y="175" width="365" height="125" as="geometry" />
        </mxCell>
        <mxCell id="af_dbt" value="2. Astronomer Cosmos (dbt Core)&#10;dbt_transformation_and_tests&#10;4-Source affected_order_ids&#10;Incremental Marts + 9/9 Tests" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1670" y="175" width="365" height="125" as="geometry" />
        </mxCell>
        <mxCell id="af_ack" value="3. @task archive_and_ack&#10;Archive raw/ -&gt; archive/&lt;audit_id&gt;/&#10;Audit ARCHIVED -&gt; COMPLETED&#10;Safe SQS ACK (DeleteMessage)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#2E7D32;fillColor=#E8F5E9;fontColor=#1B5E20;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2075" y="175" width="335" height="125" as="geometry" />
        </mxCell>

        <!-- 2. SQS + DLQ + CLOUDWATCH/SNS -->
        <mxCell id="sqs_dlq" value="Amazon SQS DLQ&#10;olist-s3-raw-arrival-dlq&#10;Isolates Poison / 0-Row CSVs&#10;Retention: 14 Days • DLQ Redrive" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#4A148C;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="sqs_main" value="Amazon SQS Main Queue&#10;olist-s3-raw-arrival-queue&#10;VisibilityTimeout: 900s • Poll 20s&#10;IAM Queue Policy (S3 -&gt; SQS)&#10;RedrivePolicy (maxReceiveCount = 3)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#4A148C;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="105" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cw_sns" value="CloudWatch Alarms + SNS&#10;• DLQ Visible &gt;= 1 (1m)&#10;• Queue Age &gt; 600s / InFlight / Backlog&#10;SNS Topic -&gt; Instant Email Alert" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#C62828;fillColor=#FFEBEE;fontColor=#B71C1C;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="320" height="165" as="geometry" />
        </mxCell>

        <!-- 3. OLIST CSV + S3 + IAM -->
        <mxCell id="raw_csv" value="Raw E-Commerce Data&#10;(Olist Dataset)&#10;9 CSVs • ~100k Orders" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#37474F;fillColor=#FFFFFF;fontColor=#263238;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="240" height="165" as="geometry" />
        </mxCell>
        <mxCell id="s3_lake" value="Amazon S3 Data Lake&#10;(Versioned • AES256 • HTTPS)&#10;• raw/ (Landing Zone)&#10;• archive/&lt;audit_id&gt;/ (90d Lifecycle)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#2E7D32;fillColor=#E8F5E9;fontColor=#1B5E20;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
