  <diagram id="aws-elt-architecture-v5" name="AWS E-Commerce Data Pipeline V5 (FCJ CloudOps, CloudFormation IaC &amp; Resilience)">
    <mxGraphModel dx="2640" dy="1340" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2640" pageHeight="1340" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. TOP BOX: APACHE AIRFLOW 3 (Pure Event-Driven Scheduling) -->
        <mxCell id="airflow_v5_box" value="APACHE AIRFLOW 3 (Astro CLI &amp; Docker)  •  Pure Event-Driven Orchestration (V5)&#xa;Schedule: [sqs_raw_arrival_asset] (Zero Cron!)  |  catchup=False  |  max_active_runs=1  |  Weekly Full-Refresh DAG (Paused)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontColor=#0D47A1;verticalAlign=top;spacingTop=10;fontFamily=Comic Sans MS;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="1290" height="225" as="geometry" />
        </mxCell>

        <!-- 4 Stage Cards inside Airflow 3 -->
        <mxCell id="af_watcher" value="Triggerer: AssetWatcher&#xa;SqsSensorTrigger&#xa;SQS Long Polling (20s)&#xa;Empty -&gt; 0 DAG Runs ($0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="885" y="160" width="275" height="122" as="geometry" />
        </mxCell>
        <mxCell id="af_load" value="1. @task load_raw&#xa;load_raw_from_sqs&#xa;Temp Stage + Empty Guard (&gt;0)&#xa;DELETE + INSERT (Atomic)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#1565C0;fillColor=#ffffff;fontColor=#0D47A1;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1195" y="160" width="285" height="122" as="geometry" />
        </mxCell>
        <mxCell id="af_dbt" value="2. Astronomer Cosmos&#xa;dbt_transformation_and_tests&#xa;4-Source affected_order_ids&#xa;Incremental Marts + dbt Tests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1515" y="160" width="295" height="122" as="geometry" />
        </mxCell>
        <mxCell id="af_ack" value="3. @task archive_ack&#xa;archive_and_ack_sqs_messages&#xa;Archive -&gt; Clean raw/&#xa;SQS ACK + Retry Safety" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#2E7D32;fillColor=#E8F5E9;fontColor=#1B5E20;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
