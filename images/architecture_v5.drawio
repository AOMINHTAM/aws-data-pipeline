          <mxGeometry x="380" y="825" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- 4. AMAZON REDSHIFT SERVERLESS -->
        <mxCell id="redshift_zone" value="AMAZON REDSHIFT SERVERLESS (4 RPUs  •  CLOUD DATA WAREHOUSE)&#10;AWS Budgets ($5/mo)  |  VPC Security Group (5439)  |  On-Demand Compute  |  Recovery Points &amp; Snapshots" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontColor=#0D47A1;verticalAlign=top;spacingTop=12;align=center;fontFamily=Comic Sans MS;fontSize=16;fontStyle=1;" vertex="1" parent="1">
