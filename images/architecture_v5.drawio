        </mxCell>
        <mxCell id="rs_stg" value="STAGING LAYER (Silver)&#10;public_staging (7 Views)&#10;Type-safe casting &amp; column cleanup&#10;Logical views (no materialized storage)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="555" width="310" height="190" as="geometry" />
        </mxCell>
        <mxCell id="rs_marts" value="MARTS LAYER (Gold • Star Schema)&#10;public_marts (Incremental delete+insert)&#10;fct_orders (4-Source Incremental)&#10;dim_customers (Customer LTV)&#10;dim_products (EN Categories)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#FFFFFF;fontColor=#0D47A1;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1655" y="555" width="390" height="190" as="geometry" />
