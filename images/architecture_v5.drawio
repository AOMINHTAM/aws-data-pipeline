        <!-- BI & Analytics (Yellow Zone) -->
        <mxCell id="bi_box" value="BI &amp; ANALYTICS&#xa;Python (export_to_csv.py)&#xa;redshift-connector + pandas&#xa;4 Clean CSVs &amp; Power BI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;strokeWidth=2;strokeColor=#F57F17;fillColor=#FFFDE7;fontColor=#F57F17;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
