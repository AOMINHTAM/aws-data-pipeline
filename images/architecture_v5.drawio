        <!-- 6. BOTTOM BANNER: AWS CLOUDFORMATION IaC -->
        <mxCell id="cfn_banner" value="AWS CloudFormation IaC (infra/cloudformation/template.yaml)&#10;• Resources: S3 (Versioning &amp; Lifecycle), SQS + DLQ, Least-Privilege IAM, 4 CloudWatch Alarms + SNS, Optional Redshift &amp; Budget&#10;• Operations: Native Auto-Rollback, Stack Clean-up (make cfn-delete), GitHub Actions CI (Ruff, cfn-lint, pytest, dbt parse)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#C62828;fillColor=#FFEBEE;fontColor=#B71C1C;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
