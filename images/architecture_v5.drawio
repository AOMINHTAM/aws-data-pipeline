        <!-- 5. BI & REPORTING -->
        <mxCell id="bi_zone" value="BI &amp; REPORTING&#10;Python (export_to_csv.py)&#10;redshift-connector + pandas&#10;4 Clean CSVs &amp; Power BI" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#F57F17;fillColor=#FFFDE7;fontColor=#E65100;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
