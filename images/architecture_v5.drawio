        <mxCell id="rs_raw" value="RAW LAYER (Bronze)&#10;raw_data (9 Tables)&#10;Temp Stage -&gt; DELETE + INSERT&#10;+ ops.pipeline_ingestion_audit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#FFFFFF;fontColor=#0D47A1;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
