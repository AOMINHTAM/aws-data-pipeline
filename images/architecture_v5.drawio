        <!-- IAM Role (Red Zone) -->
        <mxCell id="iam_box" value="AWS IAM Role&#xa;(RedshiftS3ReadOnlyRole)&#xa;STS AssumeRole (Least Privilege)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;strokeWidth=2;strokeColor=#C62828;fillColor=#FFEBEE;fontColor=#B71C1C;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
