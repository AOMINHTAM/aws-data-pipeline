        <mxCell id="dbt_bar" value="dbt Core + dbt-redshift  (Incremental delete+insert, Customer LTV, Delivery Status &amp; 9/9 Data Quality Tests)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;verticalAlign=middle;align=center;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
