  <diagram id="aws-elt-architecture-v5" name="AWS E-Commerce Data Pipeline V5">
    <mxGraphModel dx="2480" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2480" pageHeight="1240" background="#ffffff" math="0" shadow="0">
