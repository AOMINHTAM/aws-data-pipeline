          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. AMAZON SQS MAIN QUEUE + DLQ (Purple Zone) -->
        <mxCell id="sqs_main_box" value="Amazon SQS Main Queue&#xa;olist-s3-raw-arrival-queue&#xa;VisibilityTimeout: 900s • Long Poll 20s&#xa;IAM Resource Policy (S3 -&gt; SQS)&#xa;RedrivePolicy (maxReceiveCount = 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#4A148C;fontFamily=Comic Sans MS;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="95" width="305" height="175" as="geometry" />
        </mxCell>

        <mxCell id="sqs_dlq_box" value="Amazon SQS Dead-Letter Queue (DLQ)&#xa;olist-s3-raw-arrival-dlq&#xa;Isolates Poison / Empty-Stage CSVs&#xa;Retention: 14 Days • DLQ Redrive Ready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#4A148C;fontFamily=Comic Sans MS;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="305" height="150" as="geometry" />
        </mxCell>

        <!-- 3. CLOUDWATCH ALARMS + AMAZON SNS (Red Observability Zone) -->
        <mxCell id="cw_sns_box" value="CloudWatch Alarms + Amazon SNS&#xa;• DlqMessagesVisible &gt; 0 (1 min)&#xa;• MainQueueOldestMsg &gt; 900s&#xa;SNS Topic -&gt; Instant Email Alert" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#C62828;fillColor=#FFEBEE;fontColor=#B71C1C;fontFamily=Comic Sans MS;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="305" height="145" as="geometry" />
        </mxCell>

        <!-- Main Queue <-> DLQ & DLQ -> CloudWatch/SNS Arrows -->
        <mxCell id="arrow_main_dlq" value="Fail 3x -&gt; DLQ&#xa;(maxReceiveCount=3)" style="endArrow=open;endFill=0;endSize=12;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#7B1FA2;fontFamily=Comic Sans MS;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs_main_box" target="sqs_dlq_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_dlq_cw" value="Metric &gt; 0&#xa;Trigger Alarm" style="endArrow=open;endFill=0;endSize=12;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#C62828;fontFamily=Comic Sans MS;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs_dlq_box" target="cw_sns_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3 -> SQS Push Notification -->
        <mxCell id="arrow_s3_sqs" value="s3:ObjectCreated:*&#xa;Push Event (raw/*.csv)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#7B1FA2;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_box" target="sqs_main_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SQS -> Airflow AssetWatcher -->
        <mxCell id="arrow_sqs_af" value="Triggerer Wake&#xa;(Long Poll 20s)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#E65100;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs_main_box" target="af_watcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. OLIST RAW CSV & S3 DATA LAKE (Green Zone) -->
        <mxCell id="raw_csv_box" value="Raw E-Commerce&#xa;Data (Olist)&#xa;(9 CSVs • ~100k Orders)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="535" width="235" height="175" as="geometry" />
        </mxCell>
        <mxCell id="s3_box" value="Amazon S3 Data Lake&#xa;raw/ (Landing Zone)&#xa;archive/&lt;ts&gt;/ (Processed &amp; Replay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;strokeWidth=2;strokeColor=#2E7D32;fillColor=#E8F5E9;fontColor=#1B5E20;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="490" width="285" height="255" as="geometry" />
        </mxCell>
        <mxCell id="arrow_csv_s3" value="Bash &amp; AWS CLI&#xa;(upload_to_s3.sh)&#xa;aws s3 sync -&gt; raw/" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="raw_csv_box" target="s3_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. AMAZON REDSHIFT SERVERLESS (Blue & Orange Zones) -->
        <mxCell id="redshift_outer" value="AMAZON REDSHIFT SERVERLESS (4 RPUs • CLOUD DATA WAREHOUSE)&#xa;AWS Budgets ($5/mo)  |  VPC SG (5439)  |  Zero Idle RPU  |  Recovery Points &amp; Snapshots (RPO/RTO)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;sketch=1;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontColor=#0D47A1;verticalAlign=top;spacingTop=12;fontFamily=Comic Sans MS;fontSize=17;fontStyle=1;" vertex="1" parent="1">
