        <mxCell id="bi_box" value="BI &amp; ANALYTICS&#xa;Python (export_to_csv.py)&#xa;redshift-connector + pandas&#xa;4 Clean CSVs &amp; Power BI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="2000" y="435" width="260" height="190" as="geometry" />
