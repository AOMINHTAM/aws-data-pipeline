<mxfile host="app.diagrams.net" modified="2026-11-17T12:30:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="aws-elt-architecture-v4" name="AWS E-Commerce Data Pipeline V4 (Event-Driven &amp; Incremental)">
    <mxGraphModel dx="2640" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2640" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. TOP BOX: APACHE AIRFLOW 3 (Pure Event-Driven Scheduling) -->
        <mxCell id="airflow_v4_box" value="APACHE AIRFLOW 3 (Astro CLI &amp; Docker)  •  Pure Event-Driven Scheduling&#xa;Schedule: [sqs_raw_arrival_asset] (Zero Cron!)  |  catchup=False  |  max_active_runs=1  |  Optional Weekly Full-Refresh (Paused)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontColor=#0D47A1;verticalAlign=top;spacingTop=10;fontFamily=Comic Sans MS;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="75" width="1310" height="230" as="geometry" />
        </mxCell>

        <!-- 4 Stage Cards inside Airflow 3 -->
        <mxCell id="af_watcher" value="Triggerer: AssetWatcher&#xa;SqsSensorTrigger&#xa;SQS Long Polling (20s)&#xa;Empty -&gt; 0 DAG Runs ($0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="845" y="155" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="af_load" value="1. @task load_raw&#xa;load_raw_from_sqs&#xa;Temp Stage COPY + Empty Guard&#xa;DELETE + INSERT (Atomic)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#1565C0;fillColor=#ffffff;fontColor=#0D47A1;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1165" y="155" width="285" height="125" as="geometry" />
        </mxCell>
        <mxCell id="af_dbt" value="2. Astronomer Cosmos&#xa;dbt_transformation_and_tests&#xa;7 Views + Incremental Marts&#xa;Multi-Source Change Detection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#E65100;fillColor=#FFF3E0;fontColor=#E65100;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1490" y="155" width="295" height="125" as="geometry" />
        </mxCell>
        <mxCell id="af_ack" value="3. @task archive_ack&#xa;archive_and_ack_sqs_messages&#xa;Archive -&gt; Clean raw/&#xa;SQS ACK (DeleteMessage)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;strokeWidth=1.8;strokeColor=#2E7D32;fillColor=#E8F5E9;fontColor=#1B5E20;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1825" y="155" width="280" height="125" as="geometry" />
        </mxCell>

        <mxCell id="af_e1" value="" style="endArrow=open;endFill=0;endSize=12;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;" edge="1" parent="1" source="af_watcher" target="af_load">
