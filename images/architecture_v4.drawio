          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. AMAZON REDSHIFT SERVERLESS (Blue & Orange Zones) -->
        <mxCell id="redshift_outer" value="AMAZON REDSHIFT SERVERLESS (4 RPUs • CLOUD DATA WAREHOUSE)&#xa;AWS Budgets ($5/mo)  |  VPC SG (5439)  |  Skips Wake on Empty SQS ($0 RPU)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;sketch=1;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontColor=#0D47A1;verticalAlign=top;spacingTop=12;fontFamily=Comic Sans MS;fontSize=17;fontStyle=1;" vertex="1" parent="1">
