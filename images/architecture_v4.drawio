          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. AMAZON SQS QUEUE (Purple Zone) -->
        <mxCell id="sqs_main_box" value="Amazon SQS Queue&#xa;olist-s3-raw-arrival-queue&#xa;VisibilityTimeout: 900s&#xa;Long Poll 20s • Free Tier ($0)&#xa;IAM Resource Policy (S3 -&gt; SQS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#4A148C;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="105" width="295" height="185" as="geometry" />
        </mxCell>

        <!-- S3 -> SQS Push Notification -->
        <mxCell id="arrow_s3_sqs" value="s3:ObjectCreated:*&#xa;Event Notification (prefix=raw/)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#7B1FA2;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_box" target="sqs_main_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

