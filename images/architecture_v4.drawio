        <mxCell id="arrow_sqs_af" value="Triggerer Wake&#xa;(Long Poll 20s)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#E65100;fontFamily=Comic Sans MS;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqs_main_box" target="af_watcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Top Return Archive & SQS ACK Arrows -->
        <mxCell id="arrow_archive_s3" value="3a) S3 Archive &amp; Cleanup: Move raw/ -&gt; archive/&lt;ts&gt;/ (only after dbt &amp; tests PASS)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#2E7D32;fontFamily=Comic Sans MS;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
