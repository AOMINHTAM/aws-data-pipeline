        <mxCell id="dbt_up_stg" value="" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
