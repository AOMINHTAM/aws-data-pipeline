<mxfile host="app.diagrams.net" type="device">
  <diagram id="aws-elt-architecture-v3" name="AWS E-Commerce Data Pipeline V3">
    <mxGraphModel dx="2400" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2640" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. TOP BOX: APACHE AIRFLOW V3 (Event-Driven Orchestration) -->
        <mxCell id="airflow_v3_box" value="APACHE AIRFLOW V3 (Astro CLI &amp; Docker)  •  Event-Driven Orchestration&#xa;Schedule: */15 * * * *  |  catchup=False  |  max_active_runs=1  |  Automated E2E DAG" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;verticalAlign=top;spacingTop=10;fontFamily=Comic Sans MS;fontSize=18;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="810" y="70" width="1290" height="232" as="geometry" />
        </mxCell>

        <!-- 4 DAG Stage Cards inside Airflow -->
        <mxCell id="af_step1" value="1. S3KeySensor&#xa;wait_for_s3_files&#xa;Polls raw/*.csv (reschedule)&#xa;Empty -&gt; SKIP ($0 RPU)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;strokeWidth=1.8;strokeColor=#9a3412;fillColor=#FFFBF5;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="830" y="162" width="276" height="122" as="geometry" />
        </mxCell>
        <mxCell id="af_step2" value="2. @task load_raw&#xa;load_raw_from_s3&#xa;Idempotent: TRUNCATE+COPY&#xa;Returns loaded_keys (XCom)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;strokeWidth=1.8;strokeColor=#075985;fillColor=#F7FBFF;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1146" y="162" width="280" height="122" as="geometry" />
        </mxCell>
        <mxCell id="af_step3" value="3. Astronomer Cosmos&#xa;dbt_transformation_and_tests&#xa;7 Staging Views + 3 Marts&#xa;9/9 dbt Quality Tests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;strokeWidth=1.8;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1466" y="162" width="290" height="122" as="geometry" />
        </mxCell>
        <mxCell id="af_step4" value="4. @task archive_s3&#xa;archive_s3_files&#xa;Move raw/ -&gt; archive/&lt;ts&gt;/&#xa;Zero Duplicate Re-runs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;strokeWidth=1.8;strokeColor=#166534;fillColor=#F6FEF9;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1796" y="162" width="280" height="122" as="geometry" />
        </mxCell>

        <!-- Airflow Internal Arrows (1->2->3->4) -->
        <mxCell id="af_e12" value="" style="endArrow=open;endFill=0;endSize=12;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;" edge="1" parent="1" source="af_step1" target="af_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="af_e23" value="" style="endArrow=open;endFill=0;endSize=12;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;" edge="1" parent="1" source="af_step2" target="af_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="af_e34" value="" style="endArrow=open;endFill=0;endSize=12;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;" edge="1" parent="1" source="af_step3" target="af_step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sensor Dashed Arrow (Airflow -> S3 raw/) -->
        <mxCell id="arrow_sensor" value="1) S3KeySensor Poll&#xa;List raw/*.csv&#xa;(soft_fail=True)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#9a3412;fontFamily=Comic Sans MS;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="223" />
            </Array>
            <mxPoint x="810" y="223" as="sourcePoint" />
            <mxPoint x="650" y="486" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Top Return Archive Dashed Arrow (Airflow Step 4 -> S3 archive/) -->
        <mxCell id="arrow_archive" value="4) Move raw/ -&gt; archive/&lt;timestamp&gt;/ (only after dbt &amp; 9/9 tests PASS)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;dashed=1;strokeWidth=2;strokeColor=#166534;fontFamily=Comic Sans MS;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1936" y="32" />
              <mxPoint x="585" y="32" />
            </Array>
            <mxPoint x="1936" y="70" as="sourcePoint" />
            <mxPoint x="585" y="486" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Down Arrows Airflow -> Redshift -->
        <mxCell id="arrow_rs_copy_task" value="2) TRUNCATE + COPY&#xa;(redshift_connector • SSL 5439)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#075985;fontFamily=Comic Sans MS;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1286" y="302" as="sourcePoint" />
            <mxPoint x="1286" y="388" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow_rs_dbt_task" value="3) Trigger dbt DAG&#xa;(via Astronomer Cosmos)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;fontFamily=Comic Sans MS;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1611" y="302" as="sourcePoint" />
            <mxPoint x="1611" y="388" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. FAR LEFT: OLIST RAW DATA -->
        <mxCell id="raw_csv_box" value="Raw E-Commerce&#xa;Data (Olist)&#xa;(9 CSVs • ~100k Orders)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="532" width="245" height="184" as="geometry" />
        </mxCell>

        <!-- Arrow Raw CSV -> S3 -->
        <mxCell id="arrow_csv_s3" value="Bash &amp; AWS CLI&#xa;(WSL2 • upload_to_s3.sh)&#xa;aws s3 sync -&gt; raw/" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;fontFamily=Comic Sans MS;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="624" as="sourcePoint" />
            <mxPoint x="483" y="624" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. AMAZON S3 DATA LAKE (Landing + Archive) -->
        <mxCell id="s3_box" value="Amazon S3 Data Lake" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;verticalAlign=top;spacingTop=14;fontFamily=Comic Sans MS;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="483" y="486" width="270" height="262" as="geometry" />
        </mxCell>
        <mxCell id="s3_raw_prefix" value="raw/ (Landing Zone)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;strokeWidth=1.6;strokeColor=#9a3412;fillColor=#FFFBF5;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="505" y="598" width="226" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s3_archive_prefix" value="archive/&lt;ts&gt;/ (Processed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;strokeWidth=1.6;strokeColor=#166534;fillColor=#F6FEF9;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="505" y="664" width="226" height="44" as="geometry" />
        </mxCell>

        <!-- 4. AMAZON REDSHIFT SERVERLESS OUTER CONTAINER -->
        <mxCell id="redshift_outer" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="945" y="388" width="1150" height="548" as="geometry" />
        </mxCell>
        <mxCell id="redshift_title" value="AMAZON REDSHIFT SERVERLESS (4 RPUs • CLOUD DATA WAREHOUSE)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="495" width="760" height="35" as="geometry" />
        </mxCell>
        <mxCell id="finops_badge" value="AWS Budgets ($5/mo)  |  VPC SG (5439)  |  Wakes Only When S3 Has Files" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;sketch=1;strokeWidth=1.6;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1375" y="414" width="690" height="48" as="geometry" />
        </mxCell>

        <!-- RAW, STAGING, MARTS -->
        <mxCell id="raw_layer" value="RAW LAYER&#xa;(raw_data)&#xa;9 Tables • Idempotent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="990" y="554" width="250" height="166" as="geometry" />
        </mxCell>
        <mxCell id="stg_layer" value="STAGING LAYER&#xa;(public_staging)&#xa;7 Views (stg_*)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1343" y="554" width="270" height="166" as="geometry" />
        </mxCell>
        <mxCell id="marts_layer" value="MARTS LAYER&#xa;(public_marts • Star Schema)&#xa;fct_orders | dim_customers&#xa;dim_products" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1700" y="554" width="340" height="166" as="geometry" />
        </mxCell>

        <!-- S3 -> RAW LAYER Arrow + IAM Role -->
        <mxCell id="arrow_s3_rs" value="Redshift COPY&#xa;(MPP Bulk Load)" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;fontFamily=Comic Sans MS;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="753" y="620" as="sourcePoint" />
            <mxPoint x="990" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iam_box" value="AWS IAM Role&#xa;(RedshiftS3ReadOnlyRole)&#xa;STS AssumeRole (Zero Keys)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;strokeColor=#1e1e1e;fillColor=#ffffff;fontFamily=Comic Sans MS;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="539" y="792" width="345" height="114" as="geometry" />
        </mxCell>
        <mxCell id="arrow_iam" value="" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="855" y="792" as="sourcePoint" />
            <mxPoint x="855" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Internal Redshift Arrows & Bottom dbt bar -->
        <mxCell id="arrow_raw_stg" value="source()" style="endArrow=open;endFill=0;endSize=14;html=1;sketch=1;strokeWidth=2;strokeColor=#1e1e1e;fontFamily=Comic Sans MS;fontSize=13;" edge="1" parent="1" source="raw_layer" target="stg_layer">
          <mxGeometry relative="1" as="geometry" />
